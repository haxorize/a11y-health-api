#!/usr/bin/env bash
set -euo pipefail

# Covers the `uv sync` below and any `uv` call added directly to this file; the
# make targets carry it through the Makefile's own export, which holds the
# reasoning.
export UV_LOCKED=1

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# gitleaks reads the real staged diff rather than the working tree, so it runs
# here, in the developer's repo, before anything else is built.
echo "Scanning staged changes for secrets..."
gitleaks git --pre-commit --staged --redact --no-banner

# Every check below runs against a checkout of the index in a throwaway
# worktree, so what they measure is the commit being made and nothing else.
# This design cannot lose the developer's work: their index is read through a
# copy and their working tree is not touched at all. It does write a temp
# index, an unreachable commit object, and a .git/worktrees entry, all
# reclaimed by cleanup() below.
#
# Why the index and not the working tree, and the alternatives rejected before
# it, are docs/adr/0046-per-commit-checks-run-against-a-checkout-of-the-index.md.

# Both temp paths end in this run's PID. $TMPDIR is shared across a user's
# terminals, nothing serializes two commits, and the sweep below is an `rm -rf`
# — so without an identity in the name one commit deleted a concurrent one's
# live checkout mid-suite, and the victim failed with vanished-file errors that
# named nothing about the cause.
PREFIX="${TMPDIR:-/tmp}/a11y-precommit"
WORKTREE="$PREFIX-wt.$$"
STAGED_INDEX="$PREFIX-index.$$"

# A run killed outright (SIGKILL, a panic, a closed terminal) leaves its
# directory, its index copy, and its .git/worktrees entry behind. Sweep only
# what no live process still owns, by testing the PID the name carries: a
# directory whose owner is running belongs to a concurrent commit, not to a
# dead one. `git worktree prune` reclaims the entry only once the directory is
# gone, so sweep first, then prune.
for stale in "$PREFIX"-wt.* "$PREFIX"-index.*; do
  [ -e "$stale" ] || continue
  pid="${stale##*.}"
  case "$pid" in "" | *[!0-9]*) continue ;; esac
  # Ownership and self before liveness: `kill -0` cannot tell another user's
  # live process (EPERM) from a dead one (ESRCH), so under a shared /tmp it
  # would feed a live checkout to the rm below; and after a pid wrap onto a
  # SIGKILLed run's number it succeeds against this very shell, leaving that
  # directory unswept for the `worktree add` below to die on.
  [ -O "$stale" ] || continue
  if [ "$pid" != "$$" ] && kill -0 "$pid" 2>/dev/null; then continue; fi
  rm -rf "$stale"
done
# Guarded for the same reason as the one in cleanup(): pruning is housekeeping,
# and a transient .git/worktrees lock or permission problem here would abort
# under `set -e` and refuse the commit with a bare git error, before any check
# has run and with nothing in the hook's output naming the sweep.
git worktree prune || true

# Set before the first temp path exists, so a failure or a signal anywhere
# below reclaims both. The sweep above is the backstop for a SIGKILL, which no
# trap can catch.
cleanup() {
  # rm before prune, not `git worktree remove`: `uv sync` puts a .venv in there
  # and the suite leaves __pycache__, and `remove` refuses a dirty one.
  rm -rf "$WORKTREE" "$STAGED_INDEX"
  git -C "$ROOT" worktree prune || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# The index git is about to commit is not always .git/index: `git commit -a`
# builds the tree in .git/index.lock and `git commit <paths>` in a
# next-index-<pid>.lock beside it, holding it while this hook runs. Reading
# whichever one git named, through a copy, gets the tree that will actually be
# committed and never writes the real file. `--git-path` rather than a literal
# .git/index for the fallback, because .git is a file in a linked worktree.
rm -rf "$WORKTREE" "$STAGED_INDEX"
(umask 077 && : >"$STAGED_INDEX")
cp "${GIT_INDEX_FILE:-$(git rev-parse --git-path index)}" "$STAGED_INDEX"

# git exports GIT_INDEX_FILE to a hook in all three commit shapes — relative to
# the repo root for a plain `git commit`, absolute for the other two. Inherited
# by a command that runs in the new worktree the relative form resolves against
# the wrong directory, where .git is a file, and `worktree add` dies with
# "index file open failed: Not a directory".
unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_PREFIX

STAGED_TREE="$(GIT_INDEX_FILE="$STAGED_INDEX" git write-tree)"
# A commit rather than the bare tree: `worktree add` takes a commit-ish, and
# checking one out seeds the new worktree with the staged content — which is
# what `make openapi-check` regenerates against, so a staged-but-stale spec is
# still caught. The object is unreachable once the worktree is gone, and
# `git gc` reclaims it after `gc.pruneExpire` — two weeks by default.
STAGED_COMMIT="$(git commit-tree "$STAGED_TREE" -m 'pre-commit: staged tree')"

git worktree add --detach --quiet "$WORKTREE" "$STAGED_COMMIT"

# .env is gitignored, so it is absent from the index and from the checkout.
# Copied rather than left out, and this is the one deliberate exception to
# "the checks see only what is committed": config.py reads `env_file=".env"`
# relative to the working directory, so without it the checks would run
# against config.py's defaults instead of the developer's settings. Today
# every line in .env is commented out and this is a no-op; the day someone
# activates a key is the day a hook without this line tests a different
# database than the developer's own `make test` does.
if [ -f "$ROOT/.env" ]; then
  cp "$ROOT/.env" "$WORKTREE/.env"
fi

cd "$WORKTREE"

echo "Running pre-commit checks on the staged tree..."

# A fresh checkout has no .venv, and the developer's cannot be borrowed: its
# editable-install .pth is an absolute path into their src/, so a borrowed one
# would import the tree these checks exist to exclude. A sync off the warm uv
# cache is well under a second, and the blocks are shared with that cache.
uv sync --quiet

echo "Linting..."
make lint

# The one CI stage of the three that needs no database, so the only one that
# can run here; `CLAUDE.md` § Commands names the two Alembic stages that stay
# in CI and why.
echo "Checking openapi.json is not stale..."
make openapi-check

echo "Running tests..."
make test

echo "All checks passed."
